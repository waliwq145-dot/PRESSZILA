<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta
    name="description"
    content="PRESSZILA — Digital PR & Branding Agency. Make Your Brand Impossible to Ignore."
  >

  <!-- Favicon -->
  <link rel="icon" href="/images/favicon.svg">

  <!-- Main CSS -->
  <link rel="stylesheet" href="/style.css">

  <title>Get a Quote | PRESSZILA</title>
</head>

<body>

  <!-- ================= HEADER ================= -->

  <header class="site-header">

    <div class="container nav">

      <!-- LOGO -->
      <a
        class="brand"
        href="/home.html"
        aria-label="PRESSZILA home"
      >
        <img
          src="/images/logo.svg"
          alt="PRESSZILA"
        >
      </a>


      <!-- MOBILE MENU BUTTON -->
      <button
        class="menu-btn"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        ☰
      </button>


      <!-- NAVIGATION -->
      <nav
        class="nav-links"
        aria-label="Main navigation"
      >

        <a
          data-page="home.html"
          href="/home.html"
        >
          Home
        </a>

        <a
          data-page="about.html"
          href="/about.html"
        >
          About
        </a>

        <a
          data-page="solutions.html"
          href="/solutions.html"
        >
          Solutions
        </a>

        <a
          data-page="case-studies.html"
          href="/case-studies.html"
        >
          Case Studies
        </a>

        <a
          data-page="testimonials.html"
          href="/testimonials.html"
        >
          Testimonials
        </a>

        <a
          data-page="blogs.html"
          href="/blogs.html"
        >
          Blogs
        </a>

        <a
          data-page="contact.html"
          href="/contact.html"
        >
          Contact Us
        </a>

        <a
          class="btn btn-primary"
          data-page="quote.html"
          href="/quote.html"
        >
          Get a Quote
        </a>

      </nav>

    </div>

  </header>


  <!-- ================= MAIN ================= -->

  <main>

    <!-- PAGE HERO -->

    <section class="page-title">

      <div class="container reveal">

        <div class="eyebrow">
          GET A QUOTE
        </div>

        <h1>
          Bring us the<br>
          interesting brief.
        </h1>

        <p>
          Share a little context and we’ll use it to understand
          the opportunity, scope and right starting point.
        </p>

      </div>

    </section>


    <!-- ================= QUOTE FORM ================= -->

    <section class="section">

      <div class="container">

        <form
          class="form-card reveal"
          data-api="quote"
        >

          <div class="form-grid">


            <!-- NAME -->

            <div class="field">

              <label for="name">
                Name *
              </label>

              <input
                id="name"
                name="name"
                type="text"
                placeholder="Your name"
                autocomplete="name"
                required
              >

            </div>


            <!-- EMAIL -->

            <div class="field">

              <label for="email">
                Email *
              </label>

              <input
                id="email"
                name="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              >

            </div>


            <!-- COMPANY -->

            <div class="field">

              <label for="company">
                Company
              </label>

              <input
                id="company"
                name="company"
                type="text"
                placeholder="Company name"
                autocomplete="organization"
              >

            </div>


            <!-- PHONE -->

            <div class="field">

              <label for="phone">
                Phone
              </label>

              <input
                id="phone"
                name="phone"
                type="tel"
                placeholder="+92 ..."
                autocomplete="tel"
              >

            </div>


            <!-- SERVICE -->

            <div class="field">

              <label for="service">
                Service *
              </label>

              <select
                id="service"
                name="service"
                required
              >

                <option value="">
                  Choose a service
                </option>

                <option value="Digital PR">
                  Digital PR
                </option>

                <option value="Media Relations">
                  Media Relations
                </option>

                <option value="Brand Strategy">
                  Brand Strategy
                </option>

                <option value="Content & Storytelling">
                  Content &amp; Storytelling
                </option>

                <option value="Reputation Management">
                  Reputation Management
                </option>

                <option value="Creator Relations">
                  Creator Relations
                </option>

                <option value="Launch Campaign">
                  Launch Campaign
                </option>

                <option value="Social & Creative">
                  Social &amp; Creative
                </option>

              </select>

            </div>


            <!-- BUDGET -->

            <div class="field">

              <label for="budget">
                Budget *
              </label>

              <select
                id="budget"
                name="budget"
                required
              >

                <option value="">
                  Choose a budget
                </option>

                <option value="Under PKR 100,000">
                  Under PKR 100,000
                </option>

                <option value="PKR 100,000 – 250,000">
                  PKR 100,000 – 250,000
                </option>

                <option value="PKR 250,000 – 500,000">
                  PKR 250,000 – 500,000
                </option>

                <option value="PKR 500,000+">
                  PKR 500,000+
                </option>

                <option value="Not sure yet">
                  Not sure yet
                </option>

              </select>

            </div>


            <!-- TIMELINE -->

            <div class="field">

              <label for="timeline">
                Timeline *
              </label>

              <select
                id="timeline"
                name="timeline"
                required
              >

                <option value="">
                  Choose a timeline
                </option>

                <option value="ASAP">
                  ASAP
                </option>

                <option value="Within 2 weeks">
                  Within 2 weeks
                </option>

                <option value="Within 1 month">
                  Within 1 month
                </option>

                <option value="1–3 months">
                  1–3 months
                </option>

                <option value="Flexible">
                  Flexible
                </option>

              </select>

            </div>


            <!-- PROJECT DETAILS -->

            <div class="field full">

              <label for="message">
                Project Details *
              </label>

              <textarea
                id="message"
                name="message"
                rows="7"
                placeholder="What are you building, launching or changing?"
                required
              ></textarea>

            </div>

          </div>


          <!-- SUBMIT -->

          <button
            class="btn btn-primary"
            type="submit"
          >
            Request Quote
          </button>


          <!-- FORM STATUS -->

          <div
            class="form-status"
            aria-live="polite"
          ></div>

        </form>

      </div>

    </section>

  </main>


  <!-- ================= FOOTER ================= -->

  <footer class="site-footer">

    <div class="container">

      <div class="footer-grid">


        <!-- FOOTER BRAND -->

        <div class="footer-brand">

          <img
            src="/images/logo.svg"
            alt="PRESSZILA"
          >

          <p>
            Digital PR, brand strategy and storytelling built
            to make ambitious brands impossible to ignore.
          </p>


          <!-- SOCIALS -->

          <div class="socials">

            <a
              href="#"
              aria-label="Facebook"
            >
              f
            </a>

            <a
              href="#"
              aria-label="Instagram"
            >
              ◉
            </a>

            <a
              href="#"
              aria-label="X"
            >
              𝕏
            </a>

            <a
              href="#"
              aria-label="LinkedIn"
            >
              in
            </a>

          </div>

        </div>


        <!-- EXPLORE -->

        <div class="footer-col">

          <h4>
            Explore
          </h4>

          <a href="/about.html">
            About
          </a>

          <a href="/solutions.html">
            Solutions
          </a>

          <a href="/case-studies.html">
            Case Studies
          </a>

          <a href="/blogs.html">
            Blogs
          </a>

        </div>


        <!-- CONNECT -->

        <div class="footer-col">

          <h4>
            Connect
          </h4>

          <a href="/contact.html">
            Contact Us
          </a>

          <a href="/quote.html">
            Get a Quote
          </a>

          <a href="/testimonials.html">
            Testimonials
          </a>

        </div>


        <!-- SERVICES -->

        <div class="footer-col">

          <h4>
            Services
          </h4>

          <a href="/solutions.html">
            Digital PR
          </a>

          <a href="/solutions.html">
            Brand Strategy
          </a>

          <a href="/solutions.html">
            Media Relations
          </a>

          <a href="/solutions.html">
            Reputation
          </a>

        </div>

      </div>


      <!-- FOOTER BOTTOM -->

      <div class="footer-bottom">

        <span>
          © 2026 PRESSZILA. All rights reserved.
        </span>

        <span>
          Built for ambitious brands.
        </span>

      </div>

    </div>

  </footer>


  <!-- MAIN JAVASCRIPT -->
  <script src="/script.js"></script>

</body>
</html>
